# Copie este arquivo para .env e preencha os valores. O .env não é versionado.

NODE_ENV=development
PORT=3002

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=faltas_cti
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# Usuário Processo Pedagógico criado na 1ª execução (obrigatório enquanto não houver funcionários)
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_EMAIL=admin@exemplo.com
DEFAULT_ADMIN_PASSWORD=defina-uma-senha-inicial
DEFAULT_ADMIN_VALE_TRANSPORTE=0

# JWT (obrigatório: o servidor não sobe sem JWT_SECRET)
JWT_SECRET=defina-um-segredo-longo-e-exclusivo
JWT_ALGORITHM=HS256
JWT_TYPE=JWT
JWT_ISSUER=http://localhost
JWT_AUDIENCE=http://localhost
JWT_SUBJECT=acesso_sistema
# 60 dias em segundos
JWT_EXPIRES_IN_SECONDS=5184000
